PORT=8080
WS_PORT=8080
JWT_SECRET=argus_super_secret_jwt_key_2026_production_change_in_prod
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ==============================================================================
# REAL SMS DELIVERY CONFIGURATION (Choose One)
# ==============================================================================

# Option 1: Fast2SMS (Instant SMS delivery to Indian mobile numbers)
# 1. In your Fast2SMS Dashboard, click on "Dev API" in the left sidebar
# 2. Copy your Authorization / API Key and paste it below:
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio (Global SMS delivery)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+15551234567

# Option 3: Custom SMS Gateway Webhook URL
# SMS_GATEWAY_URL=https://api.sms-provider.com/send
# SMS_GATEWAY_API_KEY=your_api_key_here
