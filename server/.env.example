# Argus E2EE Gateway Environment Configuration
PORT=8080
WS_PORT=8080
JWT_SECRET=argus_super_secret_jwt_key_2026_production_change_in_prod
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CORS_ORIGIN=*

# Optional Cloud Database (e.g. Neon.tech or Supabase PostgreSQL for persistent cloud storage)
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# PG_SSL_REJECT_UNAUTHORIZED=true

# Optional Firebase Cloud Messaging (FCM) Server Key for background wakeup pushes
# FCM_SERVER_KEY=your_fcm_server_key_here

# Optional TURN Server for WebRTC NAT Traversal
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_password
